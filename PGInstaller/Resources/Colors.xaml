<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Brand & Semantic Colors  -->
    <Color x:Key="PrimaryColor">#00843D</Color>
    <Color x:Key="PrimaryHoverColor">#006B31</Color>
    <Color x:Key="GoldColor">#F2C94C</Color>
    <Color x:Key="DangerColor">#C0392B</Color>

    <!--  Surfaces (Windows 11 Mica-inspired)  -->
    <Color x:Key="BackgroundColor">#F3F4F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#F8FAFC</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>

    <!--  Typography  -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <!--  Legacy Brand Brushes (Backward Compatibility)  -->
    <SolidColorBrush x:Key="PGGreen" Color="#00843D" />
    <SolidColorBrush x:Key="PGDarkGreen" Color="#005C2B" />
    <SolidColorBrush x:Key="PGGold" Color="#F2C94C" />
    <SolidColorBrush x:Key="PGRed" Color="#C0392B" />
    <SolidColorBrush x:Key="PGPurple" Color="#8E44AD" />
    <SolidColorBrush x:Key="PGBlue" Color="#2980B9" />
    <SolidColorBrush x:Key="PGDarkBlue" Color="#34495E" />
    <SolidColorBrush x:Key="PGTextDark" Color="#2C3E50" />
    <SolidColorBrush x:Key="PGTextLight" Color="#7F8C8D" />
</ResourceDictionary>