<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PGInstaller.LoginWindow" Title="Authentication Required" Width="420" Height="430" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource SoftShadow}">
        <StackPanel Margin="32">
            <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{StaticResource PrimaryBrush}" CornerRadius="16">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="White" Text=""/>
            </Border>
            <TextBlock Margin="0,16,0,8" HorizontalAlignment="Center" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="PUREGOLD STORE SETUP"/>
            <TextBlock Margin="0,0,0,24" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Text="Version 4.1 · Enter your access key"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,24" KeyDown="TxtPassword_KeyDown" Style="{StaticResource ModernPasswordBox}"/>
            <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Width="120" Height="44" Margin="0,0,16,0" Click="BtnExit_Click" Content="EXIT" Style="{StaticResource SecondaryButton}"/>
                <Button Width="120" Height="44" Click="BtnLogin_Click" Content="UNLOCK" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Designed for Zone 11, developed by Jake Ashley Panlilio IT - San Fernando" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
