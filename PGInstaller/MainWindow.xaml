<Window
    x:Class="PGInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PGInstaller.Viewmodel"
    Title="PG-AIO Installer v3.0"
    Width="1140"
    Height="740"
    MinWidth="960"
    MinHeight="600"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="{StaticResource BaseFontFamily}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ==========================================  -->
        <!--  LEFT SIDEBAR: Control & Deployment Manifest  -->
        <!--  ==========================================  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="14,14,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  Branding & Hardware Info  -->
                    <RowDefinition Height="Auto" />
                    <!--  Department Selector  -->
                    <RowDefinition Height="Auto" />
                    <!--  Search & Toolbar  -->
                    <RowDefinition Height="*" />
                    <!--  Manifest List  -->
                    <RowDefinition Height="Auto" />
                    <!--  Options & Start CTA  -->
                </Grid.RowDefinitions>

                <!--  1. Branding & Hardware Summary  -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Width="36"
                            Height="36"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{StaticResource GoldBrush}"
                                Text="&#xE7B8;" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="PG INSTALLER" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="v3.0 • Zone 11 Auto-Deploy" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Hardware Mini-Card  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="&#xE77B;" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding PcName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="&#xE958;" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding RamInfo}" />
                                <TextBlock
                                    Margin="6,0,6,0"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="•" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding OsVersion}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  2. Department Profile  -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="10"
                        Style="{StaticResource OverlineStyle}"
                        Text="DEPARTMENT PROFILE" />
                    <ComboBox
                        Padding="10,6"
                        FontSize="13"
                        ItemsSource="{Binding Departments}"
                        SelectedItem="{Binding SelectedDepartment}"
                        Style="{StaticResource ModernComboBox}"
                        ToolTip="Select department to load preset software requirements." />
                </StackPanel>

                <!--  3. Manifest Search & Actions  -->
                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Style="{StaticResource OverlineStyle}"
                            Text="INSTALL MANIFEST" />
                        <Border
                            Grid.Column="1"
                            Padding="6,1"
                            Background="#E6F4EA"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding PendingTasksCount, Mode=OneWay}" />
                                <Run Text=" queued" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBox
                            Padding="8,5"
                            FontSize="12"
                            Style="{StaticResource ModernTextBox}"
                            Text="{Binding ManifestSearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Type to filter applications. Press Esc to clear.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            IsHitTestVisible="False"
                            Text="Search packages...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ManifestSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ManifestSearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!--  Quick Selection Bar  -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            Command="{Binding SelectAllManifestCommand}"
                            Content="Select All"
                            Style="{StaticResource GhostButton}"
                            ToolTip="Select all non-installed packages." />
                        <TextBlock
                            Margin="4,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BorderBrush}"
                            Text="|" />
                        <Button
                            Command="{Binding DeselectAllManifestCommand}"
                            Content="Clear All"
                            Style="{StaticResource GhostButton}"
                            ToolTip="Uncheck all packages." />
                    </StackPanel>
                </StackPanel>

                <!--  4. Manifest Package List (Independent Scrolling)  -->
                <Border
                    Grid.Row="3"
                    Margin="0,0,0,8"
                    Padding="4,4"
                    Style="{StaticResource GlassCard}">
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding FilteredPreviewList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  App CheckBox  -->
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}">
                                        <CheckBox.Style>
                                            <Style BasedOn="{StaticResource ModernCheckBox}" TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="Already installed. Check 'Reinstall' to force installation." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--  Installed Indicator Badge  -->
                                                <Border
                                                    Margin="6,0,0,0"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="#E6F4EA"
                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="9"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource PrimaryBrush}"
                                                        Text="✓ Installed" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>

                                    <!--  Reinstall Checkbox  -->
                                    <CheckBox
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Reinstall"
                                        FontSize="10"
                                        IsChecked="{Binding ForceInstall, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernCheckBox}"
                                        ToolTip="Force reinstall of this package."
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!--  5. Deployment Actions & Start CTA  -->
                <StackPanel Grid.Row="4">
                    <CheckBox
                        Margin="0,0,0,5"
                        Content="Create Restore Point"
                        FontSize="11"
                        IsChecked="{Binding IsRestorePointEnabled}"
                        Style="{StaticResource ModernCheckBox}"
                        ToolTip="Create a Windows System Restore point before installation." />
                    <CheckBox
                        Margin="0,0,0,10"
                        Content="Join Domain After Install"
                        FontSize="11"
                        IsChecked="{Binding JoinDomainAfterInstall}"
                        Style="{StaticResource ModernCheckBox}"
                        ToolTip="Prompt for credentials and join Active Directory domain after installation." />
                    <Button
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Command="{Binding InstallCommand}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Verify assets and begin automated software installation.">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource GoldBrush}"
                                Text="&#xE768;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Text="START INSTALLATION" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==========================================  -->
        <!--  RIGHT MAIN CONTENT: Adaptive Control Hub  -->
        <!--  ==========================================  -->
        <Grid Grid.Column="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Execution Banner or Header  -->
                <RowDefinition Height="*" />
                <!--  Tabbed Workspaces  -->
                <RowDefinition Height="Auto" />
                <!--  Footer Info  -->
            </Grid.RowDefinitions>

            <!--  Row 0: Dynamic Header / Active Execution Banner  -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <!--  State A: Running Execution Banner  -->
                <Border
                    Padding="14,10"
                    Background="#0F172A"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{StaticResource GoldBrush}"
                                Text="&#xE7BA;">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    Duration="0:0:1"
                                                    From="1"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding CurrentTaskDescription}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#94A3B8">
                                    <Run Text="Step " />
                                    <Run Text="{Binding CurrentStep, Mode=OneWay}" />
                                    <Run Text=" of " />
                                    <Run Text="{Binding TotalSteps, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource GoldBrush}">
                                <Run Text="{Binding ProgressPercentage, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                        </Grid>
                        <ProgressBar
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Height="6"
                            Maximum="100"
                            Style="{StaticResource ModernProgressBar}"
                            Value="{Binding ProgressPercentage}" />
                    </Grid>
                </Border>

                <!--  State B: Normal Header Status (Visible when not busy)  -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="20"
                            Style="{StaticResource PageTitleStyle}"
                            Text="Store Setup Control Center" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Style="{StaticResource CaptionStyle}"
                            Text="Configure networking, join Active Directory domain, deploy security suites, and manage store tools." />
                    </StackPanel>

                    <!--  Status Badges  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Background="#E6F4EA"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="● Ready" />
                        </Border>
                        <Border
                            Padding="8,4"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{Binding DomainStatus}"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="180" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Row 1: Tabbed Workspaces  -->
            <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}">
                <!--  TAB 1: SETUP & CONFIGURATION  -->
                <TabItem Header="⚙  Setup &amp; Config" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer
                        Padding="0,8,4,8"
                        CanContentScroll="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!--  1. Quick Maintenance Actions  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="QUICK ACTIONS" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="12,12"
                                Style="{StaticResource GlassCard}">
                                <UniformGrid Columns="4" Rows="1">
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding RunDefenderCommand}"
                                        Style="{StaticResource TileActionButton}"
                                        ToolTip="Disable Windows Defender">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Foreground="{StaticResource DangerBrush}"
                                                Text="&#xE8D0;" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="No Defender" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding RunDebloatCommand}"
                                        Style="{StaticResource TileActionButton}"
                                        ToolTip="Remove pre-installed Windows Bloatware">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Text="&#xE7BA;" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="Debloat" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding RunActivatorCommand}"
                                        Style="{StaticResource TileActionButton}"
                                        ToolTip="Run Windows and Office Activator">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Foreground="{StaticResource GoldBrush}"
                                                Text="&#xE785;" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="Activate" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Command="{Binding RunBackupCommand}"
                                        Style="{StaticResource TileActionButton}"
                                        ToolTip="Create System Image Backup">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Text="&#xE74E;" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="Backup" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Border>

                            <!--  2. Static Network Configuration  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="STATIC NETWORK CONFIGURATION" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="14,12"
                                Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  IP Address  -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="IP Address" />
                                        <TextBox
                                            Padding="8,5"
                                            FontSize="12"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Static IP Address (e.g., 192.168.1.101)" />
                                    </StackPanel>

                                    <!--  Gateway  -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="Default Gateway" />
                                        <TextBox
                                            Padding="8,5"
                                            FontSize="12"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding TargetGateway, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Default Gateway (e.g., 192.168.1.1)" />
                                    </StackPanel>

                                    <!--  DNS  -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="Primary DNS" />
                                        <TextBox
                                            Padding="8,5"
                                            FontSize="12"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding TargetDns, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Primary DNS (e.g., 192.168.1.100)" />
                                    </StackPanel>

                                    <!--  Apply Button  -->
                                    <Button
                                        Grid.Column="6"
                                        Width="120"
                                        Height="34"
                                        Padding="10,4"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ChangeIpCommand}"
                                        Content="APPLY NETWORK"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Apply static IP, subnet, gateway, and DNS configuration." />
                                </Grid>
                            </Border>

                            <!--  3. Computer Identity & Domain  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="COMPUTER IDENTITY &amp; ACTIVE DIRECTORY" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="14,12"
                                Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Computer Name  -->
                                    <Border
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Background="{StaticResource SurfaceVariantBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontSize="10"
                                                    Style="{StaticResource OverlineStyle}"
                                                    Text="COMPUTER NAME" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding PcName}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Height="32"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding RenameComputerCommand}"
                                                Content="Rename PC"
                                                FontSize="11"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Rename this computer (PowerShell / WMI)." />
                                        </Grid>
                                    </Border>

                                    <!--  Domain Join  -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="12,10"
                                        Background="{StaticResource SurfaceVariantBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontSize="10"
                                                    Style="{StaticResource OverlineStyle}"
                                                    Text="DOMAIN STATUS" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    Text="{Binding DomainStatus}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Height="32"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding JoinDomainCommand}"
                                                Content="Join Domain"
                                                FontSize="11"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Prompt for credentials and join Active Directory domain." />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  TAB 2: SECURITY & SOFTWARE TOOLS  -->
                <TabItem Header="🛡  Security &amp; Tools" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer
                        Padding="0,8,4,8"
                        CanContentScroll="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!--  1. Antivirus Protection  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="ANTIVIRUS DEPLOYMENT" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="14,12"
                                Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Extracts complete package and executes unattended silent installer (Avast Premium, Symantec Endpoint, AdwCleaner)." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            Padding="10,6"
                                            FontSize="12"
                                            ItemsSource="{Binding AntivirusList}"
                                            SelectedItem="{Binding SelectedAntivirus}"
                                            Style="{StaticResource ModernComboBox}"
                                            ToolTip="Select antivirus suite to deploy." />
                                        <Button
                                            Grid.Column="2"
                                            Height="34"
                                            Padding="16,4"
                                            Command="{Binding InstallAntivirusCommand}"
                                            Content="INSTALL ANTIVIRUS"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Run silent installation for the selected antivirus suite." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  2. Medicine Cabinet  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="MEDICINE CABINET &amp; PATCHERS" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="14,12"
                                Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Administrative patches and utilities (BarTender 2016 [bt2016], 2022, 10.1, Adobe, CorelDRAW)." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            Padding="10,6"
                                            FontSize="12"
                                            ItemsSource="{Binding MedicineList}"
                                            SelectedItem="{Binding SelectedMedicineName}"
                                            Style="{StaticResource ModernComboBox}"
                                            ToolTip="Select administrative tool or patcher." />
                                        <Button
                                            Grid.Column="2"
                                            Height="34"
                                            Padding="16,4"
                                            Command="{Binding RunMedicineCommand}"
                                            Content="LAUNCH TOOL"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Launch selected tool with administrator elevation." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  3. System Recovery Console  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="SYSTEM RECOVERY CONSOLE" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="14,12"
                                Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Height="54"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RunSystemRestoreCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Launch Windows System Restore wizard.">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="22"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Text="&#xE81C;" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="System Restore" />
                                                <TextBlock FontSize="10" Style="{StaticResource CaptionStyle}" Text="Revert to an earlier point" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Height="54"
                                        Padding="12,8"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RunImageRecoveryCommand}"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="Reboot directly into Windows Recovery Environment (WinRE) for recovery.">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="22"
                                                Foreground="White"
                                                Text="&#xE777;" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" Text="Image Recovery" />
                                                <TextBlock FontSize="10" Foreground="#FFD2D2" Text="Reboot to WinRE" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  TAB 3: LIVE TERMINAL & LOGS  -->
                <TabItem Header="💻  Live Terminal" Style="{StaticResource ModernTabItem}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Terminal Toolbar  -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Style="{StaticResource OverlineStyle}"
                                Text="REAL-TIME EXECUTION LOG" />
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding CopyLogCommand}"
                                    Content="Copy Log"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Copy terminal log output to clipboard." />
                                <TextBlock
                                    Margin="4,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource BorderBrush}"
                                    Text="|" />
                                <Button
                                    Command="{Binding ClearLogCommand}"
                                    Content="Clear"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Clear console window." />
                            </StackPanel>
                        </DockPanel>

                        <!--  Terminal Console  -->
                        <Border
                            Grid.Row="1"
                            Style="{StaticResource TerminalCard}">
                            <TextBox
                                Padding="12"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#A3E635"
                                IsReadOnly="True"
                                Text="{Binding LogOutput, Mode=OneWay}"
                                TextChanged="Terminal_TextChanged"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!--  Row 2: Footer  -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Puregold Price Club Inc. • Zone 11 IT • Developed by Jake Ashley Panlilio IT - SAN FERNANDO (722) • v3.0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>