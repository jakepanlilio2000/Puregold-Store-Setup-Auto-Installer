<Window
    x:Class="PGInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PGInstaller.Viewmodel"
    Title="PG-AIO Installer v2.2"
    Width="1200"
    Height="850"
    MinWidth="1000"
    MinHeight="700"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="{StaticResource BaseFontFamily}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ==========================================  -->
        <!--  LEFT SIDEBAR: Context & Control  -->
        <!--  ==========================================  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <!--  Top: Branding  -->
                <StackPanel Margin="24,32,24,24" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="44"
                            Height="44"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Foreground="White"
                                Text="&#xE7B8;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="PG INSTALLER" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="v2.2 Zone 11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Bottom: Primary Action  -->
                <StackPanel Margin="24,0,24,24" DockPanel.Dock="Bottom">
                    <CheckBox
                        Margin="0,0,0,16"
                        Content="Create System Restore Point"
                        IsChecked="{Binding IsRestorePointEnabled}"
                        Style="{StaticResource ModernCheckBox}"
                        ToolTip="Creates a restore point before installation begins." />
                    <Button
                        Height="56"
                        HorizontalAlignment="Stretch"
                        Command="{Binding InstallCommand}"
                        Content="START INSTALLATION"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>

                <!--  Middle: Responsive Scrollable Context  -->
                <ScrollViewer
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,0,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!--  System Info  -->
                            <RowDefinition Height="Auto" />
                            <!--  Department  -->
                            <RowDefinition Height="Auto" />
                            <!--  Search  -->
                            <RowDefinition Height="*" />
                            <!--  Manifest (Fills remaining space)  -->
                        </Grid.RowDefinitions>

                        <!--  System Info  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,12"
                            Style="{StaticResource OverlineStyle}"
                            Text="SYSTEM INFO" />
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,24"
                            Padding="16"
                            Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="&#xE77B;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyStyle}"
                                        Text="{Binding PcName}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="&#xE950;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="{Binding CpuInfo}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="&#xE958;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="{Binding RamInfo}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="&#xE8D0;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="{Binding OsVersion}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Department Selector  -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,12"
                            Style="{StaticResource OverlineStyle}"
                            Text="DEPARTMENT" />
                        <ComboBox
                            Grid.Row="1"
                            Margin="0,0,0,24"
                            ItemsSource="{Binding Departments}"
                            SelectedItem="{Binding SelectedDepartment}"
                            Style="{StaticResource ModernComboBox}" />

                        <!--  Search  -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ManifestSearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                IsHitTestVisible="False"
                                Text="Search applications...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ManifestSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ManifestSearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!--  Install Manifest (Responsive: Fills remaining height)  -->
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,0,0,12"
                            Style="{StaticResource OverlineStyle}"
                            Text="INSTALLATION MANIFEST" />
                        <Border Grid.Row="3" Style="{StaticResource GlassCard}">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding FilteredPreviewList}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="16,10"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernCheckBox}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  ==========================================  -->
        <!--  MAIN CONTENT: Dashboard & Modules  -->
        <!--  ==========================================  -->
        <ScrollViewer
            Grid.Column="1"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!--  Header  -->
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard" />
                <TextBlock
                    Margin="0,8,0,32"
                    Style="{StaticResource CaptionStyle}"
                    Text="Manage system maintenance, recovery, and deployment tools." />

                <!--  KPI Cards  -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OverlineStyle}" Text="MACHINE STATUS" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="Ready" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OverlineStyle}" Text="DOMAIN STATUS" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource GoldBrush}"
                                Text="{Binding DomainStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OverlineStyle}" Text="SELECTED DEPT" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding SelectedDepartment}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OverlineStyle}" Text="PENDING TASKS" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding PendingTasksCount}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource CaptionStyle}"
                                Text="Selected Apps" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Network & System Configuration (Grouped)  -->
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource OverlineStyle}"
                    Text="SYSTEM &amp; NETWORK CONFIGURATION" />
                <Border Margin="0,0,0,32" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="IP Address" />
                                <TextBox
                                    Style="{StaticResource ModernTextBox}"
                                    Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="e.g., 192.168.1.101" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Gateway" />
                                <TextBox
                                    Style="{StaticResource ModernTextBox}"
                                    Text="{Binding TargetGateway, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="e.g., 192.168.1.1" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Primary DNS" />
                                <TextBox
                                    Style="{StaticResource ModernTextBox}"
                                    Text="{Binding TargetDns, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="e.g., 192.168.1.100" />
                            </StackPanel>

                            <Button
                                Grid.Column="6"
                                Width="140"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Command="{Binding ChangeIpCommand}"
                                Content="APPLY NETWORK"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>

                        <Separator Margin="0,24" Background="{StaticResource BorderBrush}" />

                        <WrapPanel>
                            <Button
                                Width="180"
                                Height="60"
                                Margin="0,0,16,0"
                                Command="{Binding RenameComputerCommand}"
                                Style="{StaticResource SecondaryButton}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="&#xE77B;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Rename PC" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="180"
                                Height="60"
                                Command="{Binding JoinDomainCommand}"
                                Style="{StaticResource SecondaryButton}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="&#xE90B;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Join Domain" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!--  Quick Actions  -->
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource OverlineStyle}"
                    Text="QUICK ACTIONS" />
                <Border Margin="0,0,0,32" Style="{StaticResource GlassCard}">
                    <WrapPanel>
                        <Button
                            Width="160"
                            Height="100"
                            Margin="0,0,16,16"
                            Command="{Binding RunDefenderCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Disable Windows Defender">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{StaticResource DangerBrush}"
                                    Text="&#xE8D0;" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="No Defender" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="160"
                            Height="100"
                            Margin="0,0,16,16"
                            Command="{Binding RunDebloatCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Remove Windows Bloatware">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="&#xE7BA;" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Debloat" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="160"
                            Height="100"
                            Margin="0,0,16,16"
                            Command="{Binding RunActivatorCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Run Windows/Office Activator">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{StaticResource GoldBrush}"
                                    Text="&#xE785;" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Activate" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="160"
                            Height="100"
                            Margin="0,0,16,16"
                            Command="{Binding RunBackupCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Create Windows Image Backup">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="&#xE74E;" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Backup" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!--  Recovery & Tools  -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Recovery Console  -->
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource OverlineStyle}"
                            Text="RECOVERY CONSOLE" />
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Button
                                    Height="80"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RunSystemRestoreCommand}"
                                    Style="{StaticResource SecondaryButton}">
                                    <StackPanel
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="24"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            Text="&#xE81C;" />
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="System Restore" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Revert to an earlier point" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Height="80"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RunImageRecoveryCommand}"
                                    Style="{StaticResource DangerButton}">
                                    <StackPanel
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="24"
                                            Foreground="White"
                                            Text="&#xE777;" />
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="Image Recovery" />
                                            <TextBlock Foreground="#FFC0C0" Text="Reboot to WinRE" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Software Tools  -->
                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource OverlineStyle}"
                            Text="SOFTWARE TOOLS" />
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Style="{StaticResource CardTitleStyle}"
                                    Text="Antivirus Protection" />
                                <ComboBox
                                    Margin="0,0,0,12"
                                    ItemsSource="{Binding AntivirusList}"
                                    SelectedItem="{Binding SelectedAntivirus}"
                                    Style="{StaticResource ModernComboBox}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding InstallAntivirusCommand}"
                                    Content="INSTALL AV"
                                    Style="{StaticResource PrimaryButton}" />

                                <Separator Margin="0,20" Background="{StaticResource BorderBrush}" />

                                <TextBlock
                                    Margin="0,0,0,12"
                                    Style="{StaticResource CardTitleStyle}"
                                    Text="Medicine Cabinet" />
                                <ComboBox
                                    Margin="0,0,0,12"
                                    ItemsSource="{Binding MedicineList}"
                                    SelectedItem="{Binding SelectedMedicineName}"
                                    Style="{StaticResource ModernComboBox}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RunMedicineCommand}"
                                    Content="LAUNCH TOOL"
                                    Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!--  Live Terminal  -->
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource OverlineStyle}"
                    Text="LIVE TERMINAL" />
                <Border Height="350" Style="{StaticResource TerminalCard}">
                    <Grid>
                        <TextBox
                            Padding="24"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="#A3E635"
                            IsReadOnly="True"
                            Text="{Binding LogOutput, Mode=OneWay}"
                            TextChanged="Terminal_TextChanged"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  Busy Overlay  -->
                        <Border
                            Background="#CC0F172A"
                            CornerRadius="12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel
                                MaxWidth="500"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!--  Animated Icon  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="48"
                                    Foreground="#A3E635"
                                    Text="&#xE7BA;">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        AutoReverse="True"
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0.3"
                                                        Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>

                                <!--  Dynamic Task Description  -->
                                <TextBlock
                                    Margin="0,20,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding CurrentTaskDescription}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <!--  Step Counter  -->
                                <TextBlock
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#94A3B8">
                                    <Run Text="Step " />
                                    <Run Text="{Binding CurrentStep, Mode=OneWay}" />
                                    <Run Text=" of " />
                                    <Run Text="{Binding TotalSteps, Mode=OneWay}" />
                                </TextBlock>

                                <!--  Determinate Progress Bar  -->
                                <ProgressBar
                                    Width="400"
                                    Height="8"
                                    Background="#1E293B"
                                    BorderThickness="0"
                                    Foreground="{StaticResource GoldBrush}"
                                    Maximum="100"
                                    Style="{StaticResource ModernProgressBar}"
                                    Value="{Binding ProgressPercentage}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  Footer  -->
                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="Ensure 'Assets' folder is present in the application directory." />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="Designed for Zone 11" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="Developed by Jake Ashley Panlilio IT - SAN FERNANDO (722)" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>