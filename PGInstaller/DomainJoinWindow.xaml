<Window
    x:Class="PGInstaller.DomainJoinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Join Domain"
    Width="480"
    Height="380"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Margin="0,0,0,-51"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Effect="{StaticResource SoftShadow}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,24"
                FontSize="22"
                Style="{StaticResource PageTitleStyle}"
                Text="JOIN COMPANY DOMAIN" />

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,6"
                Style="{StaticResource CaptionStyle}"
                Text="DOMAIN NAME" />
            <TextBox
                x:Name="TxtDomain"
                Grid.Row="2"
                Margin="0,0,0,16"
                Style="{StaticResource ModernTextBox}" />

            <TextBlock
                Grid.Row="3"
                Margin="0,0,0,6"
                Style="{StaticResource CaptionStyle}"
                Text="USERNAME" />
            <TextBox
                x:Name="TxtUsername"
                Grid.Row="4"
                Margin="0,0,0,16"
                Style="{StaticResource ModernTextBox}" />

            <TextBlock
                Grid.Row="5"
                Margin="0,0,0,6"
                Style="{StaticResource CaptionStyle}"
                Text="PASSWORD" />
            <PasswordBox
                x:Name="TxtPassword"
                Grid.Row="6"
                Margin="0,0,0,24"
                Style="{StaticResource ModernPasswordBox}" />

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="LoadingBar"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource PrimaryBrush}"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <Button
                    x:Name="BtnJoin"
                    Grid.Column="1"
                    Width="110"
                    Height="44"
                    Margin="0,0,12,0"
                    Click="BtnJoin_Click"
                    Content="JOIN"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    x:Name="BtnCancel"
                    Grid.Column="2"
                    Width="110"
                    Height="44"
                    Click="BtnCancel_Click"
                    Content="CANCEL"
                    Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Grid>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>