<Window x:Class="PGInstaller.DomainJoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Domain" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JOIN COMPANY DOMAIN" Style="{StaticResource PageTitleStyle}" FontSize="22" Margin="0,0,0,24" />

            <TextBlock Grid.Row="1" Text="DOMAIN NAME" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
            <TextBox Grid.Row="2" x:Name="TxtDomain" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="3" Text="USERNAME" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
            <TextBox Grid.Row="4" x:Name="TxtUsername" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="5" Text="PASSWORD" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
            <PasswordBox Grid.Row="6" x:Name="TxtPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,24"/>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="LoadingBar" Grid.Column="0" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                <Button Grid.Column="1" Content="JOIN" Width="110" Height="44" Margin="0,0,12,0" x:Name="BtnJoin" Click="BtnJoin_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Grid.Column="2" Content="CANCEL" Width="110" Height="44" x:Name="BtnCancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Grid>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>